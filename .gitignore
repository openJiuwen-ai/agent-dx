# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
wheels/
*.whl

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Monorepo build products
/target/
/out/
/.adx-cache/
.venv/
**/__pycache__/
**/*.egg-info/
**/dist/

# Source scripts under build/ are tracked.
!/build/
!/build/**
# Source inclusion must not re-include Python bytecode generated by CI.
/build/**/__pycache__/
/build/**/*.py[cod]

# Local sandboxd diagnostic output
/sandboxd.log

# Local verification environments
/.local/

# Local cloud access keys
credentials*.csv

# Local multi-host validation scratch (scripts, logs, binaries)
.validation/

# Outlet design notes and the two-host validation report stay local: they are
# working material for this deployment, not part of the engine's contract.
afs/outlet-cross-node-spec-v2.md
afs/outlet-two-node-validation-report.md
