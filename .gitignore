# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
wheels/
*.whl

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Monorepo build products
/target/
/out/
.venv/
**/__pycache__/
**/*.egg-info/
**/dist/
/platform/control-plane/sandbox-api/internal/gen/

# Source scripts under build/ are tracked.
!/build/
!/build/**
# Source inclusion must not re-include Python bytecode generated by CI.
/build/**/__pycache__/
/build/**/*.py[cod]

# Local sandboxd diagnostic output
/sandboxd.log
