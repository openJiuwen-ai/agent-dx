{
  "name": "credential-crypto",
  "image": "registry.example.com/adx-credential-crypto:1",
  "isolation_runtime": "runsc",
  "resources": { "cpu_millis": 500, "memory_mib": 256 },
  "lifecycle": { "idle_timeout_seconds": 0 },
  "service": [{ "protocol": "http", "port": 18443 }],
  "init_timeout_seconds": 60,
  "readiness_probe": {
    "tcp_socket": { "port": 18443 },
    "period_seconds": 2,
    "timeout_seconds": 1
  },
  "mounts": [{
    "type": "bind",
    "host_path": "/mnt/private/adx-credential-crypto",
    "target": "/run/adx-credential-crypto",
    "options": ["ro"],
    "create_if_missing": false
  }]
}
