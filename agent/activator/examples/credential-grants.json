{
  "listen": "127.0.0.1:8091",
  "redis_url": "redis://127.0.0.1:6379/0",
  "namespace": "adx-environment-local",
  "environment_url": "http://127.0.0.1:8081",
  "environment_api_key_envs": {
    "digitalmate": "ADX_PLATFORM_TENANT_API_KEY"
  },
  "allow_plaintext_transport": true,
  "environment_ca_file": null,
  "request_timeout_seconds": 60,
  "binding_cache": {
    "capacity": 200000,
    "idle_seconds": 18000
  },
  "sandbox_network": {
    "sandbox_cidrs": [
      "192.0.2.0/24"
    ],
    "internal_cidrs": [],
    "public_egress": true,
    "egress_allow": []
  },
  "credential_grants_token_env": "ADX_CREDENTIAL_GRANT_VERIFIER_TOKEN",
  "credential_delivery": {
    "template": "orbit",
    "root": "/mnt/shared/credential-identities",
    "ca_file": "/etc/adx/credential-crypto/gateway-ca.pem",
    "uid": 10001,
    "gid": 10001,
    "ttl_seconds": 2592000,
    "renew_before_seconds": 604800
  }
}
