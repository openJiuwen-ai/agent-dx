{
  "listen": "0.0.0.0:8443",
  "ca": "/opt/adx/config/tls/ca.pem",
  "certificate": "/opt/adx/config/tls/api-server.pem",
  "private_key": "/opt/adx/config/tls/api-server.key",
  "server_name": "adx.internal",
  "rpc_timeout_seconds": 90,
  "cache_entries": 10000,
  "auth_cache_ttl_seconds": 10,
  "agent_address": "",
  "edge_mode": "standalone",
  "discovery": {
    "redis_url": "redis://127.0.0.1:6379/",
    "namespace": "adx",
    "poll_seconds": 5
  }
}
