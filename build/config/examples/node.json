{
  "node_id": "node-1",
  "listen": "0.0.0.0:19001",
  "advertised_address": "node-1:19001",
  "proxy_address": "node-1:19002",
  "tls": {
    "ca": "/etc/adx/tls/ca.pem",
    "certificate": "/etc/adx/tls/node-1.pem",
    "private_key": "/etc/adx/tls/node-1.key",
    "server_name": "adx.internal",
    "peers": {
      "master": "/etc/adx/tls/master.der",
      "frontend": "/etc/adx/tls/frontend.der"
    }
  },
  "sandboxd_socket": "/run/sandboxd/sandboxd.sock",
  "proxy_socket": "/run/adx/route.sock",
  "report_interval_seconds": 5,
  "rpc_timeout_seconds": 30,
  "rrt_port": 50090,
  "rrt_command": [
    "/usr/local/bin/rrt-runtime"
  ],
  "rrt_env": {},
  "discovery": {
    "redis_url": "redis://127.0.0.1:6379/",
    "namespace": "adx"
  },
  "checkpoint_dir": "/var/lib/adx/checkpoints",
  "resource_source": {
    "kind": "sandboxd",
    "socket": "/run/sandboxd/node-resource.sock",
    "valid_for_seconds": 30
  },
  "degradation_journal": "/var/lib/adx/degraded/results.sqlite",
  "pressure": {
    "disk_path": "/var/lib/adx",
    "thresholds": {
      "memory_high_percent": 90,
      "memory_low_percent": 80,
      "disk_high_percent": 90,
      "disk_low_percent": 80
    }
  },
  "metrics_listen": "127.0.0.1:19003",
  "runtime_ready_timeout_seconds": 120,
  "checkpoint_gc": {
    "enabled": true,
    "min_age_seconds": 86400,
    "interval_seconds": 300,
    "max_artifacts": 100
  }
}
