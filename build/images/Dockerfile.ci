# ADX build environment bootstrapped from official Ubuntu 20.04.
# Keep the focal glibc baseline for released GNU binaries.
ARG BASE
FROM ${BASE}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN sed -i 's|http://mirrors.aliyun.com/ubuntu-ports|https://mirrors.aliyun.com/ubuntu-ports|g' /etc/apt/sources.list \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::Retries=2 update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       autoconf automake binutils build-essential busybox-static ca-certificates \
       cmake curl git libssl-dev libtool musl-tools pkg-config strace unzip wget \
       libbz2-dev libffi-dev liblzma-dev libreadline-dev libsqlite3-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH=amd64
ARG RUST_VERSION=1.95.0
ARG RUSTUP_VERSION=1.28.2
ARG PYTHON_VERSION=3.11.14
ARG PYTHON_SHA256=8d3ed8ec5c88c1c95f5e558612a725450d2452813ddad5e58fdb1a53b1209b78
ARG PROTOC_VERSION=25.1
ARG GO_VERSION=1.25.5
ARG GO_SHA256_AMD64=9e9b755d63b36acf30c12a9a3fc379243714c1c6d3dd72861da637f336ebb35b
ARG GO_SHA256_ARM64=b00b694903d126c588c378e72d3545549935d3982635ba3f7a964c9fa23fe3b9
RUN case "$TARGETARCH" in \
      amd64) go_sha=$GO_SHA256_AMD64 ;; \
      arm64) go_sha=$GO_SHA256_ARM64 ;; \
      *) exit 2 ;; \
    esac \
    && curl --fail --location --retry 3 --connect-timeout 20 --max-time 600 \
      "https://mirrors.aliyun.com/golang/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tar.gz \
    && echo "${go_sha}  /tmp/go.tar.gz" | sha256sum --check \
    && rm -rf /usr/local/go \
    && tar -xzf /tmp/go.tar.gz -C /usr/local \
    && rm /tmp/go.tar.gz

ENV GOROOT=/usr/local/go \
    PATH=/opt/adx-build-tools/python/bin:/opt/adx-build-tools/erofs-utils-1.8.10/bin:/usr/local/go/bin:/root/.cargo/bin:/opt/buildtools/protoc/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GOTOOLCHAIN=local \
    RUSTUP_TOOLCHAIN=${RUST_VERSION} \
    OBS_PYTHON=/opt/adx-build-tools/python/bin/python3

RUN case "$TARGETARCH" in amd64) rust_host=x86_64-unknown-linux-gnu ;; arm64) rust_host=aarch64-unknown-linux-gnu ;; *) exit 2 ;; esac \
    && curl --fail --location --retry 3 --connect-timeout 20 --max-time 600 \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${rust_host}/rustup-init" -o /tmp/rustup-init \
    && curl --fail --location --retry 3 --connect-timeout 20 --max-time 600 \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${rust_host}/rustup-init.sha256" -o /tmp/rustup-init.sha256 \
    && cd /tmp && sha256sum --check rustup-init.sha256 \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "$RUST_VERSION" \
    && rm /tmp/rustup-init /tmp/rustup-init.sha256 \
    && rustup toolchain install "$RUST_VERSION" --profile minimal --component rustfmt,clippy \
    && rustup default "$RUST_VERSION" \
    && case "$TARGETARCH" in amd64) target=x86_64-unknown-linux-musl ;; arm64) target=aarch64-unknown-linux-musl ;; esac \
    && rustup target add "$target" \
    && rustup component add rustfmt clippy \
    && GOBIN=/usr/local/bin go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.11 \
    && GOBIN=/usr/local/bin go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2

RUN mkdir -p /root/.cargo \
    && printf '%s\n' \
       '# 多个国内源可同时定义，但同一时刻只有 replace-with 指向的那个生效' \
       '[source.crates-io]' \
       "replace-with = 'aliyun'" \
       '' \
       '# 阿里云（当前生效，稀疏索引，dl 走 mirrors.aliyun.com/crates/api/v1/crates）' \
       '[source.aliyun]' \
       'registry = "sparse+https://mirrors.aliyun.com/crates.io-index/"' \
       '' \
       '# 字节 rsproxy（备选）' \
       '[source.rsproxy]' \
       'registry = "sparse+https://rsproxy.cn/index/"' \
       '' \
       '# 中科大（备选）' \
       '[source.ustc]' \
       'registry = "sparse+https://mirrors.ustc.edu.cn/crates.io-index/"' \
       '' \
       '# 清华（备选）' \
       '[source.tuna]' \
       'registry = "sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/"' \
       '' \
       '[net]' \
       'git-fetch-with-cli = true' \
       > /root/.cargo/config.toml

RUN case "$TARGETARCH" in amd64) protoc_arch=x86_64 ;; arm64) protoc_arch=aarch_64 ;; *) exit 2 ;; esac \
    && curl --fail --location --retry 3 --connect-timeout 20 --max-time 600 \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${protoc_arch}.zip" -o /tmp/protoc.zip \
    && mkdir -p /opt/buildtools/protoc \
    && unzip -q /tmp/protoc.zip -d /opt/buildtools/protoc \
    && rm /tmp/protoc.zip

RUN curl --fail --location --retry 3 --connect-timeout 20 --max-time 600 \
      "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz" -o /tmp/python.tar.xz \
    && echo "${PYTHON_SHA256}  /tmp/python.tar.xz" | sha256sum --check \
    && mkdir /tmp/python \
    && tar -xJf /tmp/python.tar.xz -C /tmp/python --strip-components=1 \
    && cd /tmp/python && ./configure --prefix=/usr/local --with-ensurepip=install \
    && make -j 8 && make install \
    && rm -rf /tmp/python /tmp/python.tar.xz

COPY build/runtime/erofs-tools.sh /tmp/erofs-tools.sh
RUN --mount=type=bind,source=build/images/source-cache,target=/tmp/adx-source-cache \
    mkdir -p /opt/adx-build-tools \
    && if [[ -f /tmp/adx-source-cache/erofs-utils-1.8.10.tar.gz ]]; then \
         cp /tmp/adx-source-cache/erofs-utils-1.8.10.tar.gz /opt/adx-build-tools/erofs-utils-1.8.10.tar.gz; \
       fi \
    && ADX_EROFS_CACHE=/opt/adx-build-tools JOBS=4 bash /tmp/erofs-tools.sh \
    && rm /tmp/erofs-tools.sh

ARG REDIS_VERSION=7.2.5
ARG REDIS_SHA256=5981179706f8391f03be91d951acafaeda91af7fac56beffb2701963103e423d
RUN --mount=type=bind,source=build/images/source-cache,target=/tmp/adx-source-cache \
    if [[ -f /tmp/adx-source-cache/redis-${REDIS_VERSION}.tar.gz ]]; then \
      cp "/tmp/adx-source-cache/redis-${REDIS_VERSION}.tar.gz" /tmp/redis.tar.gz; \
    else \
      curl --fail --location --retry 3 --connect-timeout 20 --max-time 600 \
        "https://download.redis.io/releases/redis-${REDIS_VERSION}.tar.gz" -o /tmp/redis.tar.gz; \
    fi \
    && echo "${REDIS_SHA256}  /tmp/redis.tar.gz" | sha256sum --check \
    && mkdir /tmp/redis \
    && tar -xzf /tmp/redis.tar.gz -C /tmp/redis --strip-components=1 \
    && make -C /tmp/redis -j 4 MALLOC=libc BUILD_TLS=no REDIS_CFLAGS= REDIS_LDFLAGS= redis-server redis-cli \
    && install -m 0755 /tmp/redis/src/redis-server /tmp/redis/src/redis-cli /usr/local/bin/ \
    && rm -rf /tmp/redis /tmp/redis.tar.gz

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUN python3 -m venv /opt/adx-build-tools/python \
    && /opt/adx-build-tools/python/bin/pip install --no-cache-dir --index-url "$PIP_INDEX_URL" \
       'PyYAML==6.0.2' 'build==1.2.2.post1' 'esdk-obs-python==3.25.8'

COPY .buildkite/verify-build-image.sh /usr/local/bin/adx-verify-build-image
RUN chmod 0755 /usr/local/bin/adx-verify-build-image \
    && /usr/local/bin/adx-verify-build-image

RUN /opt/adx-build-tools/python/bin/pip install --no-cache-dir --index-url "$PIP_INDEX_URL" --upgrade pip

WORKDIR /workspace
