# Supply an approved Linux base compatible with the staged executable (pin its digest).
# Build context contains only adx-credential-crypto; private service files are runtime mounts.
ARG BASE
FROM ${BASE}
COPY --chmod=0555 adx-credential-crypto /usr/local/bin/adx-credential-crypto
USER 10002:10002
WORKDIR /
EXPOSE 18443
ENTRYPOINT ["/usr/local/bin/adx-credential-crypto"]
CMD ["serve", "--config", "/run/adx-credential-crypto/server.json"]
