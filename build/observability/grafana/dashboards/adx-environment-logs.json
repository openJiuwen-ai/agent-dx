      "tooltip": "Open on-demand log search, initially the last 15 minutes."
    },
    {
      "title": "Environments",
      "type": "link",
      "url": "/d/adx-environments",
      "includeVars": true,
      "keepTime": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "id": 21,
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{adx_env=~\"$adx_env\",component_name=\"adx-runtime\"} | runtime_id =~ `${runtime_id:raw}` | label_format adx_keyword_match=`{{ contains (urldecode \"${log_search:percentencode}\") (__line__) }}` | adx_keyword_match=\"true\" | drop adx_keyword_match",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "title": "Environment Logs",
      "type": "logs",
      "description": "Main-process stdout/stderr. Runtime ID contains Environment ID and generation. Runtime filter is a regex; .* matches all, .*environment-id.* selects its generations. Log text is literal and case-sensitive. At most 500 lines per query. SDK command responses are separate."
    },
    {
      "id": 22,
      "type": "table",
      "title": "HTTP Request Traces",
      "description": "One row per matching HTTP span, showing endpoint, actual component, response status and span duration. Streaming HTTP spans may finish before background tasks; click Trace ID for the complete trace. Excludes unmatched routes and health checks. Does not require an upstream root span.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": false
              },
              {
                "id": "custom.width",
                "value": 290
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace",
                    "url": "",
                    "internal": {
                      "datasourceUid": "tempo",
                      "datasourceName": "Tempo",
                      "query": {
                        "query": "${__value.raw}",
                        "queryType": "traceql"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Endpoint"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 500
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Start Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 225
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Span Duration"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "spans",
          "query": "{ resource.adx_env =~ \"$adx_env\" && (resource.service.name = \"adx-apiserver\" || resource.service.name = \"adx-ingress\") && name =~ \"^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|OTHER) /.*\" && span.http.route != \"/unmatched\" && name != \"GET /healthz\" && name != \"GET /metrics\" } | select(span.http.request.method, span.http.route, span.http.response.status_code, resource.service.name)",
          "limit": 50,
          "filters": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true,
              "spanID": true,
              "adx_env": true,
              "http.request.method": true,
              "http.route": true,
              "nested": true
            },
            "indexByName": {
              "time": 0,
              "name": 1,
              "service.name": 2,
              "http.response.status_code": 3,
              "duration": 4,
              "traceIdHidden": 5,
              "Start time": 0,
              "Name": 1,
              "Duration": 4
            },
            "renameByName": {
              "time": "Start Time",
              "name": "Endpoint",
              "service.name": "Component",
              "http.response.status_code": "Status",
              "duration": "Span Duration",
              "traceIdHidden": "Trace ID",
              "Start time": "Start Time",
              "Name": "Endpoint",
              "Duration": "Span Duration"
            }
          }
        }
      ]
    }
  ],
  "preload": false,
  "refresh": "",
  "schemaVersion": 42,
  "tags": [
    "adx",
    "schedule",
    "instances",
    "metrics",
    "monitoring"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(adx_coordinator_node_capacity_cpu_millis, adx_env)",
        "includeAll": true,
        "label": "adx_env",
        "name": "adx_env",
        "options": [],
        "query": {
          "query": "label_values(adx_coordinator_node_capacity_cpu_millis, adx_env)",
          "refId": "Prometheus-adx-env-Variable"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "name": "runtime_id",
        "label": "Runtime ID regex",
        "description": "RE2 regex. Use \\x60 to match a backtick.",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "name": "log_search",
        "label": "Log text contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "Case-sensitive literal text. Enter backslashes and quotes directly; leave empty to match all lines."
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "ADX Environment Logs",
  "uid": "adx-environment-logs",
  "version": 3,
  "weekStart": ""
