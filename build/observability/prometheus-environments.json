{
  "global": {
    "scrape_interval": "30s"
  },
  "scrape_configs": [
    {
      "job_name": "adx-environment-detail",
      "metrics_path": "/metrics/environments",
      "static_configs": [
        {
          "targets": [
            "127.0.0.1:19091"
          ],
          "labels": {
            "adx_env": "adx",
            "component_name": "adxlet"
          }
        }
      ]
    },
    {
      "job_name": "adx-environment-inventory",
      "metrics_path": "/metrics/environments",
      "static_configs": [
        {
          "targets": [
            "127.0.0.1:19090"
          ],
          "labels": {
            "adx_env": "adx",
            "component_name": "adx-coordinator"
          }
        }
      ]
    }
  ]
}
