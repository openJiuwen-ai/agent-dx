[Unit]
Description=Agent DX sandboxd runtime backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=PATH=/opt/adx/current/runtime/sandboxd:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/env python3 /opt/adx/current/lib/sandboxd_preflight.py --runtime-source image
ExecStart=/opt/adx/current/runtime/sandboxd/sandboxd --root /var/lib/adx-sandboxd --config /etc/adx/sandboxd/sandboxd.toml --socket /run/sandboxd/sandboxd.sock --http-address 127.0.0.1:23099 --log-file /var/lib/adx-sandboxd/sandboxd.log
Restart=on-failure
RestartSec=2
Delegate=yes
KillMode=process
LimitNOFILE=1048576
RuntimeDirectory=sandboxd
RuntimeDirectoryMode=0700
StateDirectory=adx-sandboxd
StateDirectoryMode=0700
# OCI layer directories must be traversable by non-root sandbox processes.
UMask=0022

[Install]
WantedBy=multi-user.target
