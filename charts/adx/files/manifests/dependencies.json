[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "redis"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "redis"
        }
      },
      "strategy": {
        "type": "Recreate"
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "redis"
          }
        },
        "spec": {
          "securityContext": {
            "fsGroup": 10001,
            "runAsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "containers": [
            {
              "args": [
                "--bind",
                "0.0.0.0",
                "--port",
                "6379",
                "--dir",
                "/data",
                "--appendonly",
                "yes",
                "--appendfsync",
                "everysec",
                "--aclfile",
                "/secrets/redis.acl",
                "--save",
                ""
              ],
              "command": [
                "/opt/adx/bin/redis-server"
              ],
              "imagePullPolicy": "IfNotPresent",
              "name": "redis",
              "readinessProbe": {
                "failureThreshold": 3,
                "periodSeconds": 5,
                "successThreshold": 1,
                "tcpSocket": {
                  "port": 6379
                },
                "timeoutSeconds": 1
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              },
              "terminationMessagePath": "/dev/termination-log",
              "terminationMessagePolicy": "File",
              "volumeMounts": [
                {
                  "mountPath": "/data",
                  "name": "data"
                },
                {
                  "mountPath": "/secrets",
                  "name": "credentials"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "data",
              "persistentVolumeClaim": {
                "claimName": "redis-data"
              }
            },
            {
              "name": "credentials",
              "secret": {
                "defaultMode": 288,
                "items": [
                  {
                    "key": "redis.acl",
                    "path": "redis.acl"
                  }
                ]
              }
            }
          ],
          "automountServiceAccountToken": false,
          "enableServiceLinks": false
        }
      }
    }
  }
]
