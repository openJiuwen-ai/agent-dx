              {
                "name": "credentials",
                "secret": {
                  "defaultMode": 288,
                  "items": [
                    {
                      "key": "ca.pem",
                      "path": "ca.pem"
                    },
                    {
                      "key": "ingress.pem",
                      "path": "ingress.pem"
                    },
                    {
