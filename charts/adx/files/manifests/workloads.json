      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app": "ingress"
        },
        "name": "ingress"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "ingress"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ingress"
            }
          },
          "spec": {
            "affinity": {
              "podAntiAffinity": {
                "preferredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "podAffinityTerm": {
                      "labelSelector": {
                        "matchLabels": {
                          "app": "ingress"
                        }
                      },
                      "topologyKey": "kubernetes.io/hostname"
                    },
                    "weight": 100
                  }
                ]
              }
            },
            "automountServiceAccountToken": false,
            "containers": [
              {
                "env": [
                  {
                    "name": "ADX_RUNTIME_PAYLOAD"
