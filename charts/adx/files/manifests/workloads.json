    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "labels": {
          "adx.deployment": "adx-example",
          "app.kubernetes.io/part-of": "adx"
        },
        "name": "adx-node"
      },
      "spec": {
        "persistentVolumeClaimRetentionPolicy": {
          "whenDeleted": "Retain",
          "whenScaled": "Retain"
        },
        "podManagementPolicy": "OrderedReady",
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "adx-node"
          }
        },
        "serviceName": "adx-node",
        "template": {
          "metadata": {
            "labels": {
              "app": "adx-node"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "env": [
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "apiVersion": "v1",
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "POD_IP",
                    "valueFrom": {
                      "fieldRef": {
                        "apiVersion": "v1",
                        "fieldPath": "status.podIP"
                      }
                    }
                  },
                  {
                    "name": "ADX_RUNTIME_PAYLOAD"
                  }
                ],
                "imagePullPolicy": "IfNotPresent",
                "name": "runtime",
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python3",
                      "-c",
                      "import urllib.request,socket; text=urllib.request.urlopen('http://127.0.0.1:17091/metrics',timeout=2).read().decode(); metrics=dict(line.split() for line in text.splitlines() if line and not line.startswith('#') and len(line.split())==2); assert all(metrics.get(name)=='1' for name in ('adx_node_accepting_allocations','adx_node_resource_observation_fresh','adx_node_device_observation_fresh')); socket.create_connection(('127.0.0.1',17001),timeout=1).close()"
                    ]
                  },
                  "failureThreshold": 3,
                  "initialDelaySeconds": 15,
                  "periodSeconds": 15,
                  "successThreshold": 1,
                  "timeoutSeconds": 8
                },
                "securityContext": {
                  "privileged": true,
                  "runAsUser": 0
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/opt/adx/node-start.py",
                    "name": "node-bootstrap",
                    "readOnly": true,
                    "subPath": "start.py"
                  },
                  {
                    "mountPath": "/work",
                    "name": "data"
                  },
                  {
                    "mountPath": "/secrets",
                    "name": "credentials"
                  },
                  {
                    "mountPath": "/registry",
                    "name": "registry"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "enableServiceLinks": false,
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 90,
            "volumes": [
              {
                "configMap": {
                  "defaultMode": 292
                },
                "name": "node-bootstrap"
              },
              {
                "name": "credentials",
                "secret": {
                  "defaultMode": 288,
                  "items": [
                    {
                      "key": "ca.pem",
                      "path": "ca.pem"
                    },
                    {
                      "key": "node.pem",
                      "path": "node.pem"
                    },
                    {
                      "key": "node.key",
                      "path": "node.key"
                    },
                    {
                      "key": "coordinator.der",
                      "path": "coordinator.der"
                    },
                    {
                      "key": "apiserver.der",
                      "path": "apiserver.der"
                    },
                    {
                      "key": "redis-key",
                      "path": "redis-key"
                    },
                    {
                      "key": "execd-token",
                      "path": "execd-token"
                    }
                  ]
                }
              },
              {
                "name": "registry",
                "secret": {
                  "defaultMode": 256
                }
              }
            ]
          }
        },
        "updateStrategy": {
          "rollingUpdate": {
            "partition": 0
          },
          "type": "RollingUpdate"
        },
        "volumeClaimTemplates": [
          {
            "apiVersion": "v1",
            "kind": "PersistentVolumeClaim",
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {}
              },
              "volumeMode": "Filesystem"
            }
          }
        ]
      }
