+func s3Endpoint(endpoint, requestedRegion string) (scheme string, host string, region string, err error) {
+	parsed, err := url.Parse(endpoint)
+	if err != nil ||
+		(parsed.Scheme != "http" && parsed.Scheme != "https") ||
+		parsed.Host == "" ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		parsed.RawQuery != "" ||
+		parsed.Fragment != "" ||
+		parsed.User != nil {
+		return "", "", "", fmt.Errorf("invalid S3 endpoint %q: expected an http(s) origin", endpoint)
+	}
+	region = requestedRegion
+	if region == "" {
+		region = "us-east-1"
+		parts := strings.Split(parsed.Hostname(), ".")
+		for index, part := range parts {
+			switch {
+			case part == "s3" && index+1 < len(parts) && parts[index+1] != "amazonaws":
+				region = parts[index+1]
+			case strings.HasPrefix(part, "s3-") && len(part) > len("s3-"):
+				region = strings.TrimPrefix(part, "s3-")
+			}
+		}
+	}
+	return parsed.Scheme, parsed.Host, region, nil
+}
 
