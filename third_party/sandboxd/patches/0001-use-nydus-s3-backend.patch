+func TestPrepareGuestFilesMountsRuntimeBeforeInjection(t *testing.T) {
+	files := []firecrackerproto.FileSpec{
+		{Target: "/run/adx/image-process.json"},
+		{Target: "/etc/hosts"},
+	}
+	var calls []string
+	err := prepareGuestFiles(
+		files,
+		func() error {
+			calls = append(calls, "mount-runtime")
+			return nil
+		},
+		func(file firecrackerproto.FileSpec) error {
+			calls = append(calls, "inject:"+file.Target)
+			return nil
+		},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{
+		"mount-runtime",
+		"inject:/run/adx/image-process.json",
+		"inject:/etc/hosts",
+	}
+	if strings.Join(calls, "\n") != strings.Join(want, "\n") {
+		t.Fatalf("guest file preparation order = %q, want %q", calls, want)
+	}
+}
