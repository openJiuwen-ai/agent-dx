+func TestS3Endpoint(t *testing.T) {
+	tests := []struct {
+		name      string
+		endpoint  string
+		requested string
+		scheme    string
+		host      string
+		region    string
+		wantErr   bool
+	}{
+		{name: "MinIO", endpoint: "http://127.0.0.1:9000", scheme: "http", host: "127.0.0.1:9000", region: "us-east-1"},
+		{name: "trailing slash", endpoint: "http://127.0.0.1:9000/", scheme: "http", host: "127.0.0.1:9000", region: "us-east-1"},
+		{name: "AWS regional", endpoint: "https://s3.eu-west-2.amazonaws.com", scheme: "https", host: "s3.eu-west-2.amazonaws.com", region: "eu-west-2"},
+		{name: "explicit region", endpoint: "https://objects.example.com", requested: "cn-test-1", scheme: "https", host: "objects.example.com", region: "cn-test-1"},
+		{name: "missing scheme", endpoint: "objects.example.com", wantErr: true},
+		{name: "path is not an origin", endpoint: "https://objects.example.com/path", wantErr: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			scheme, host, region, err := s3Endpoint(test.endpoint, test.requested)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("s3Endpoint() error = %v, wantErr %v", err, test.wantErr)
+			}
+			if scheme != test.scheme || host != test.host || region != test.region {
+				t.Fatalf("s3Endpoint() = (%q, %q, %q), want (%q, %q, %q)", scheme, host, region, test.scheme, test.host, test.region)
+			}
+		})
+	}
+}
