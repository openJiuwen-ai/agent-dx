+func prepareGuestFiles(
+	files []firecrackerproto.FileSpec,
+	mountRuntime func() error,
+	inject func(firecrackerproto.FileSpec) error,
+) error {
+	// /run, /tmp and the other runtime filesystems hide image contents at the
+	// same paths. Mount them first so managed files such as the inherited OCI
+	// entrypoint contract remain visible to the sandbox process.
+	if err := mountRuntime(); err != nil {
+		return err
+	}
+	for _, file := range files {
+		if err := inject(file); err != nil {
+			return err
+		}
+	}
+	return nil
+}
