diff --git a/cmd/firecracker-agent/main.go b/cmd/firecracker-agent/main.go
index a3cb7c1..5d1ad5c 100644
--- a/cmd/firecracker-agent/main.go
+++ b/cmd/firecracker-agent/main.go
@@ -858,10 +858,23 @@ func (handoff *checkpointHandoff) close() {
 	<-handoff.done
 }
 
+var setRealtimeClock = func(unixNanos int64) error {
+	if unixNanos <= 0 {
+		return errors.New("restore realtime timestamp is required")
+	}
+	timeval := unix.NsecToTimeval(unixNanos)
+	return unix.Settimeofday(&timeval)
+}
+
 func releaseCheckpoint(request firecrackerproto.CheckpointRequest) error {
 	if request.Outcome != "resume" && request.Outcome != "restore" && request.Outcome != "error" {
 		return fmt.Errorf("invalid checkpoint outcome %q", request.Outcome)
 	}
+	if request.Outcome == "restore" {
+		if err := setRealtimeClock(request.RealtimeUnixNanos); err != nil {
+			return fmt.Errorf("set restored realtime clock: %w", err)
+		}
+	}
 	state.mu.RLock()
 	handoff := state.handoff
 	state.mu.RUnlock()
diff --git a/cmd/firecracker-agent/main_test.go b/cmd/firecracker-agent/main_test.go
index 1e3f447..00ae5de 100644
--- a/cmd/firecracker-agent/main_test.go
+++ b/cmd/firecracker-agent/main_test.go
@@ -634,3 +634,55 @@ func (w *recordingWriteCloser) Close() error {
 	w.closed = true
 	return nil
 }
+
+func TestReleaseCheckpointRestoreSetsRealtimeBeforeHandoff(t *testing.T) {
+	old := setRealtimeClock
+	defer func() { setRealtimeClock = old }()
+	var got int64
+	setRealtimeClock = func(value int64) error { got = value; return nil }
+	reader := make(chan string, 1)
+	handoff := &checkpointHandoff{environmentPath: filepath.Join(t.TempDir(), "restore-env"), reader: reader}
+	state.mu.Lock()
+	previous := state.handoff
+	state.handoff = handoff
+	state.mu.Unlock()
+	defer func() { state.mu.Lock(); state.handoff = previous; state.mu.Unlock() }()
+	request := firecrackerproto.CheckpointRequest{Outcome: "restore", RealtimeUnixNanos: 1234, Environment: []string{"A=B"}}
+	if err := releaseCheckpoint(request); err != nil {
+		t.Fatal(err)
+	}
+	if got != request.RealtimeUnixNanos {
+		t.Fatalf("clock = %d", got)
+	}
+	select {
+	case outcome := <-reader:
+		if outcome != "restore" {
+			t.Fatalf("outcome = %q", outcome)
+		}
+	default:
+		t.Fatal("restore was not handed off")
+	}
+}
+
+func TestReleaseCheckpointRestoreClockFailureDoesNotHandoff(t *testing.T) {
+	old := setRealtimeClock
+	defer func() { setRealtimeClock = old }()
+	setRealtimeClock = func(int64) error { return errors.New("denied") }
+	handoff := &checkpointHandoff{environmentPath: filepath.Join(t.TempDir(), "restore-env"), reader: make(chan string, 1)}
+	state.mu.Lock()
+	previous := state.handoff
+	state.handoff = handoff
+	state.mu.Unlock()
+	defer func() { state.mu.Lock(); state.handoff = previous; state.mu.Unlock() }()
+	if err := releaseCheckpoint(firecrackerproto.CheckpointRequest{Outcome: "restore", RealtimeUnixNanos: 1234}); err == nil {
+		t.Fatal("restore clock failure accepted")
+	}
+	select {
+	case <-handoff.reader:
+		t.Fatal("failed restore was handed off")
+	default:
+	}
+	if _, err := os.Stat(handoff.environmentPath); !os.IsNotExist(err) {
+		t.Fatalf("restore environment written: %v", err)
+	}
+}
