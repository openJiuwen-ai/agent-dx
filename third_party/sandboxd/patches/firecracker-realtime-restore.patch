@@ -199,3 +199,22 @@ type testError struct {
 func (err *testError) Error() string {
 	return err.value
 }
+
+func TestCheckpointRequestRealtimeRoundTrip(t *testing.T) {
+	request := CheckpointRequest{Outcome: "restore", RealtimeUnixNanos: 1_700_000_000_123_456_789}
+	var encoded bytes.Buffer
+	if err := WriteMessage(&encoded, MessageCheckpoint, request); err != nil {
+		t.Fatal(err)
+	}
+	_, payload, err := ReadMessage(&encoded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded CheckpointRequest
+	if err := Decode(payload, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.RealtimeUnixNanos != request.RealtimeUnixNanos {
+		t.Fatalf("realtime = %d", decoded.RealtimeUnixNanos)
+	}
+}
