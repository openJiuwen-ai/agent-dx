+// restoreCheckpointRequest samples host realtime immediately before releasing the
+// restored guest, so the guest can correct the snapshot's stale wall clock.
+func restoreCheckpointRequest(environment []string) firecrackerproto.CheckpointRequest {
+	return firecrackerproto.CheckpointRequest{
+		Outcome:           "restore",
+		Environment:       environment,
+		RealtimeUnixNanos: time.Now().UnixNano(),
