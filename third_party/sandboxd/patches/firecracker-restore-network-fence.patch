+package firecracker
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRestoreNetworkFence(t *testing.T) {
+	tests := []struct {
+		name    string
+		failAt  string
+		wantLog []string
+	}{
+		{
+			name:    "successful handoff activates only after guest network is configured",
+			wantLog: []string{"down", "load", "agent", "network", "up", "release"},
+		},
+		{
+			name:    "down failure aborts before snapshot load",
+			failAt:  "down",
+			wantLog: []string{"down"},
+		},
+		{
+			name:    "snapshot load failure keeps tap isolated",
+			failAt:  "load",
+			wantLog: []string{"down", "load"},
+		},
+		{
+			name:    "agent readiness failure keeps tap isolated",
+			failAt:  "agent",
+			wantLog: []string{"down", "load", "agent"},
+		},
+		{
+			name:    "guest network failure keeps tap isolated",
+			failAt:  "network",
+			wantLog: []string{"down", "load", "agent", "network"},
+		},
+		{
+			name:    "tap activation failure aborts before workload release",
+			failAt:  "up",
+			wantLog: []string{"down", "load", "agent", "network", "up"},
+		},
+		{
+			name:    "workload release failure re-isolates the tap",
+			failAt:  "release",
+			wantLog: []string{"down", "load", "agent", "network", "up", "release", "down"},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			var log []string
+			step := func(name string) func() error {
+				return func() error {
+					log = append(log, name)
+					if test.failAt == name {
+						return errors.New(name + " failed")
+					}
+					return nil
+				}
+			}
+
+			err := runRestoreNetworkHandoff(restoreNetworkHandoff{
+				isolateTap:      step("down"),
+				loadSnapshot:    step("load"),
+				waitForAgent:    step("agent"),
+				setNetwork:      step("network"),
+				activateTap:     step("up"),
+				releaseWorkload: step("release"),
+			})
+
+			if test.failAt == "" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, test.failAt+" failed")
+			}
+			assert.Equal(t, test.wantLog, log)
+		})
+	}
+}
