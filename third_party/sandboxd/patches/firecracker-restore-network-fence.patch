+func TestTAPRestoreFenceChangesOnlyTheRequestedLinkState(t *testing.T) {
+	tap := convergedTap(t, 13)
+	resource, err := newTapRecoveryFixture(t, tap).manager.tapResource(tap, net.ParseIP("10.88.0.5"))
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		name      string
+		up        bool
+		configure func(*fakeLinkOperations)
+		wantUp    int
+		wantDown  int
+		wantErr   string
+	}{
+		{name: "isolate", wantDown: 1},
+		{name: "activate", up: true, wantUp: 1},
+		{
+			name: "isolation error is wrapped",
+			configure: func(ops *fakeLinkOperations) {
+				ops.setDownErr = errors.New("netlink down failed")
+			},
+			wantDown: 1,
+			wantErr:  "isolate TAP",
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ops := &fakeLinkOperations{link: tap}
+			if test.configure != nil {
+				test.configure(ops)
+			}
+
+			err := setTAPRestoreFence(resource, test.up, ops)
+			if test.wantErr == "" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, test.wantErr)
+			}
+			assert.Equal(t, test.wantUp, ops.setUpCount)
+			assert.Equal(t, test.wantDown, ops.setDownCount)
+		})
+	}
+}
+
+func TestTAPRestoreFenceRejectsInvalidOrReplacedEndpoint(t *testing.T) {
+	tap := convergedTap(t, 13)
+	resource, err := newTapRecoveryFixture(t, tap).manager.tapResource(tap, net.ParseIP("10.88.0.5"))
+	require.NoError(t, err)
+
+	tests := []struct {
+		name     string
+		resource func() *NetResource
+		link     netlink.Link
+		wantErr  string
+	}{
+		{
+			name: "wrong schema",
+			resource: func() *NetResource {
+				copy := *resource
+				copy.SchemaVersion = NetResourceSchemaVersion + 1
+				return &copy
+			},
+			link:    tap,
+			wantErr: "unsupported network resource schema",
+		},
+		{
+			name: "wrong interface name",
+			resource: func() *NetResource {
+				copy := *resource
+				iface := *resource.Interface
+				iface.Name = "tap.wrong"
+				copy.Interface = &iface
+				return &copy
+			},
+			link:    tap,
+			wantErr: "identity mismatch",
+		},
+		{
+			name: "non tap link",
+			resource: func() *NetResource {
+				copy := *resource
+				return &copy
+			},
+			link: &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{
+				Name: resource.Interface.Name, Index: resource.Interface.Index,
+			}},
+			wantErr: "want tuntap",
+		},
+		{
+			name: "replaced ifindex",
+			resource: func() *NetResource {
+				copy := *resource
+				return &copy
+			},
+			link:    convergedTap(t, 14),
+			wantErr: "was replaced externally",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			ops := &fakeLinkOperations{link: test.link}
+			err := setTAPRestoreFence(test.resource(), false, ops)
+			require.ErrorContains(t, err, test.wantErr)
+			assert.Zero(t, ops.setUpCount)
+			assert.Zero(t, ops.setDownCount)
+		})
+	}
+}
