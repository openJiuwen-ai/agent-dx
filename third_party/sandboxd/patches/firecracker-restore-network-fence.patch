+// IsolateTAPForRestore disables host TAP forwarding until the guest agent has
+// installed the network identity assigned to this lease. This host-side fence
+// does not prove that a VMM has drained every guest descriptor captured in the
+// snapshot; runtime coverage must check that boundary on the target VMM.
+func IsolateTAPForRestore(resource *NetResource) error {
+	return setTAPRestoreFence(resource, false, systemLinkOperations{})
+}
+
+// ActivateTAPAfterRestore releases a restore fence after the guest agent has
+// installed the assigned network identity.
+func ActivateTAPAfterRestore(resource *NetResource) error {
+	return setTAPRestoreFence(resource, true, systemLinkOperations{})
+}
+
+func setTAPRestoreFence(resource *NetResource, up bool, links linkOperations) error {
+	if resource == nil || resource.Interface == nil {
+		return errors.New("TAP restore fence resource interface is missing")
+	}
+	if resource.SchemaVersion > NetResourceSchemaVersion {
+		return fmt.Errorf(
+			"unsupported network resource schema %d (max %d)",
+			resource.SchemaVersion,
+			NetResourceSchemaVersion,
+		)
+	}
+	if resource.EndpointType != EndpointTypeTap {
+		return fmt.Errorf("TAP restore fence requires TAP endpoint, got %q", resource.EndpointType)
+	}
+	ip4 := resource.Ip.To4()
+	if ip4 == nil {
+		return fmt.Errorf("TAP restore fence has invalid IPv4 address %q", resource.Ip)
+	}
+	expectedName := util.IpToTap(ip4.String())
+	if resource.Interface.Name != expectedName {
+		return fmt.Errorf(
+			"TAP restore fence identity mismatch: interface %q, want %q",
+			resource.Interface.Name,
+			expectedName,
+		)
+	}
+	link, err := links.LinkByName(expectedName)
+	if err != nil {
+		return fmt.Errorf("find TAP %s for restore fence: %w", expectedName, err)
+	}
+	if link.Type() != "tuntap" {
+		return fmt.Errorf("restore fence endpoint %s has type %q, want tuntap", expectedName, link.Type())
+	}
+	if resource.Interface.Index != 0 && resource.Interface.Index != link.Attrs().Index {
+		return fmt.Errorf(
+			"restore fence endpoint %s was replaced externally: ifindex %d, lease records %d",
+			expectedName,
+			link.Attrs().Index,
+			resource.Interface.Index,
+		)
+	}
+	if up {
+		if err := links.LinkSetUp(link); err != nil {
+			return fmt.Errorf("activate TAP %s after restore: %w", expectedName, err)
+		}
+		return nil
+	}
+	if err := links.LinkSetDown(link); err != nil {
+		return fmt.Errorf("isolate TAP %s for restore: %w", expectedName, err)
+	}
+	return nil
+}
