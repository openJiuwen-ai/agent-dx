+type restoreNetworkHandoff struct {
+	isolateTap      func() error
+	loadSnapshot    func() error
+	snapshotLoaded  func()
+	waitForAgent    func() error
+	setNetwork      func() error
+	activateTap     func() error
+	releaseWorkload func() error
+}
+
+// runRestoreNetworkHandoff keeps the restored VM's TAP isolated while the
+// snapshot still carries its source guest MAC and IP. The guest agent must
+// receive the target identity before bridge forwarding resumes.
+func runRestoreNetworkHandoff(handoff restoreNetworkHandoff) error {
+	if err := handoff.isolateTap(); err != nil {
+		return fmt.Errorf("isolate restored Firecracker TAP: %w", err)
+	}
+	if err := handoff.loadSnapshot(); err != nil {
+		return fmt.Errorf("load Firecracker checkpoint: %w", err)
+	}
+	if handoff.snapshotLoaded != nil {
+		handoff.snapshotLoaded()
+	}
+	if err := handoff.waitForAgent(); err != nil {
+		return fmt.Errorf("wait for restored Firecracker agent: %w", err)
+	}
+	if err := handoff.setNetwork(); err != nil {
+		return fmt.Errorf("configure restored Firecracker network: %w", err)
+	}
+	if err := handoff.activateTap(); err != nil {
+		return fmt.Errorf("activate restored Firecracker TAP: %w", err)
+	}
+	if err := handoff.releaseWorkload(); err != nil {
+		return errors.Join(
+			fmt.Errorf("release restored Firecracker sandbox: %w", err),
+			func() error {
+				if fenceErr := handoff.isolateTap(); fenceErr != nil {
+					return fmt.Errorf("re-isolate restored Firecracker TAP: %w", fenceErr)
+				}
+				return nil
+			}(),
+		)
+	}
+	return nil
+}
