+// configureMMDS installs a deployment-owned metadata document before guest
+// vCPUs run. Firecracker exposes the document at the link-local MMDS endpoint.
+func (api *firecrackerAPI) configureMMDSBeforeBoot(ctx context.Context, document string) error {
+	if document == "" {
+		return nil
+	}
+	var decoded map[string]any
+	if err := json.Unmarshal([]byte(document), &decoded); err != nil || decoded == nil {
+		return fmt.Errorf("trusted guest metadata must be a JSON object")
+	}
+	if err := api.put(ctx, "/mmds/config", map[string]any{
+		"version": "V2", "network_interfaces": []string{"eth0"},
+	}); err != nil {
+		return err
+	}
+	return api.put(ctx, "/mmds", decoded)
+}
+
+// updateMMDSAfterRestore changes only the document. Firecracker rejects MMDS
+// configuration changes after a VM has booted, including a paused snapshot.
+func (api *firecrackerAPI) updateMMDSAfterRestore(ctx context.Context, document string) error {
+	if document == "" {
+		return nil
+	}
+	var decoded map[string]any
+	if err := json.Unmarshal([]byte(document), &decoded); err != nil || decoded == nil {
+		return fmt.Errorf("trusted guest metadata must be a JSON object")
+	}
+	return api.put(ctx, "/mmds", decoded)
+}
