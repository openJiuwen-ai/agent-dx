+
+func TestLoadSnapshotMetadataFailurePreventsResume(t *testing.T) {
+	socket := filepath.Join(t.TempDir(), "api.sock")
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	var mu sync.Mutex
+	var paths []string
+	server := &http.Server{Handler: http.HandlerFunc(func(
+		writer http.ResponseWriter,
+		request *http.Request,
+	) {
+		defer request.Body.Close()
+		mu.Lock()
+		paths = append(paths, request.URL.Path)
+		mu.Unlock()
+		if request.URL.Path == "/mmds" {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		writer.WriteHeader(http.StatusNoContent)
+	})}
+	serverDone := make(chan error, 1)
+	go func() { serverDone <- server.Serve(listener) }()
+	defer func() {
+		_ = server.Close()
+		<-serverDone
+	}()
+
+	api := newFirecrackerAPI(socket)
+	err = api.loadSnapshot(
+		context.Background(),
+		"/checkpoint/vmstate", "/checkpoint/memory", "", "tap-test",
+		"/run/firecracker/test.vsock", "", "", `{"accessTokenHash":"digest"}`,
+	)
+	if err == nil {
+		t.Fatal("metadata write failure was ignored")
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	want := []string{"/snapshot/load", "/mmds"}
+	if len(paths) != len(want) {
+		t.Fatalf("API paths = %v, want %v", paths, want)
+	}
+	for index := range want {
+		if paths[index] != want[index] {
+			t.Fatalf("API path %d = %q, want %q", index, paths[index], want[index])
+		}
+	}
+}
